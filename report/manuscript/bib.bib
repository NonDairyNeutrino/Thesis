@inproceedings{Li2007,
author = {Li, Chuanpeng and Ding, Chen and Shen, Kai},
title = {Quantifying the cost of context switch},
year = {2007},
isbn = {9781595937513},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/1281700.1281702},
doi = {10.1145/1281700.1281702},
abstract = {Measuring the indirect cost of context switch is a challenging problem. In this paper, we show our results of experimentally quantifying the indirect cost of context switch using a synthetic workload. Specifically, we measure the impact of program data size and access stride on context switch cost. We also demonstrate the potential impact of OS background interrupt handling on the measurement accuracy. Such impact can be alleviated by using a multi-processor system on which one processor is employed for context switch measurement while the other runs OS background tasks.},
booktitle = {Proceedings of the 2007 Workshop on Experimental Computer Science},
pages = {2–es},
keywords = {cache interference, context switch},
location = {San Diego, California},
series = {ExpCS '07}
}

